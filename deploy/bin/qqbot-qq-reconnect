#!/usr/bin/env python3
"""SnowLuma ↔ AstrBot 断线自愈：
AstrBot 的 OneBot 端口(6199)没有连接时，通过 SnowLuma 面板 API 重新"注入 QQ 进程 + 刷新"，
让 OneBot 桥接重新连上。重启后 SnowLuma 偶尔不会自动挂载 QQ 客户端，这个脚本负责兜住。
"""
import json
import os
import subprocess
import sys
import time
import urllib.request

PANEL = "http://127.0.0.1:5099"
PASS_FILE = "/root/.qqbot-panel-pass"
USER = "admin"


def connected() -> bool:
    try:
        out = subprocess.run(["ss", "-tn"], capture_output=True, text=True, timeout=10).stdout
        return ":6199" in out
    except Exception:
        return False


def _req(path: str, data=None, token: str = "", method: str = "GET"):
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(PANEL + path, data=body, method=method,
                                 headers={"Content-Type": "application/json",
                                          **({"Authorization": "Bearer " + token} if token else {})})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read().decode() or "{}")


def main() -> int:
    if connected():
        print("6199 已连接，无需处理")
        return 0
    try:
        pw = open(PASS_FILE, encoding="utf-8").read().strip()
    except Exception:
        print("读不到面板密码 %s" % PASS_FILE)
        return 2
    try:
        r = _req("/api/login", {"username": USER, "password": pw}, method="POST")
        token = r.get("token") or ""
        if not token:
            print("面板登录失败：%s" % r)
            return 3
        plist = _req("/api/processes", token=token).get("list") or []
        pid = plist[0]["pid"] if plist else 0
        if not pid:
            print("面板里没找到 QQ 进程")
            return 4
        print("重新注入 QQ 进程 pid=%s ..." % pid)
        _req("/api/processes/%s/load" % pid, token=token, method="POST")
        time.sleep(3)
        st = _req("/api/processes/%s/refresh" % pid, token=token, method="POST").get("process") or {}
        print("QQ 状态：loggedIn=%s uin=%s status=%s" % (st.get("loggedIn"), st.get("uin"), st.get("status")))
        for _ in range(10):
            if connected():
                print("OneBot 桥接已恢复（6199 已连接）")
                return 0
            time.sleep(2)
        print("还是没连上 6199，可能需要人工看看面板")
        return 5
    except Exception as e:
        print("自愈失败：%r" % (e,))
        return 6


if __name__ == "__main__":
    sys.exit(main())
