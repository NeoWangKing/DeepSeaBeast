#!/bin/bash
# qqbot-status —— AstrBot QQ 机器人速查（只读，不碰任何服务）
CFG=/opt/astrbot/data/cmd_config.json
echo "=== 服务 ==="
printf "  astrbot: %s (%s)\n" "$(systemctl is-active astrbot)" "$(systemctl is-enabled astrbot 2>/dev/null)"
echo "=== 资源 ==="
systemctl show astrbot -p MemoryCurrent --value | awk '{printf "  内存: %.0f MB (上限 1024 MB)\n", $1/1048576}'
ps -o %cpu,rss,etime -C astrbot --no-headers 2>/dev/null | awk '{printf "  CPU: %s%%  RSS: %.0f MB  已运行: %s\n", $1, $2/1024, $3}'
echo "=== 端口 ==="
ss -lnt 2>/dev/null | grep -E "6185|6199" | awk '{print "  监听:", $4}'
printf "  协议端(SnowLuma)已连接: %s 条\n" "$(ss -tn 2>/dev/null | grep -c ':6199')"
echo "=== 配置摘要 ==="
python3 - "$CFG" <<'PY'
import json, sqlite3, sys
d = json.load(open(sys.argv[1], encoding="utf-8-sig"))
ar = d.get("agent_runner", {}).get("config", {})
ps = d.get("platform_settings", {})
print("  模型:", ar.get("model", {}).get("provider_id"))
print("  人格:", ar.get("persona", {}).get("persona_id"), "| max_steps:", ar.get("misc", {}).get("max_steps"))
print("  群白名单:", ps.get("id_whitelist") or "未限制", "| 管理员:", d.get("admins_id"))
print("  @全体唤醒:", "否" if ps.get("ignore_at_all") else "是", "| 限频:", ps.get("rate_limit"))
try:
    c = sqlite3.connect("/opt/astrbot/data/data_v4.db")
    print("  可用人格:", ", ".join(r[0] for r in c.execute("select persona_id from personas")))
except Exception as e:
    print("  人格读取失败:", e)
PY
echo "=== 机器人故障计数（agent）==="
python3 - <<PY
import json, time
p = "/opt/astrbot/data/plugins/qq_peak_gate/data/agent_faults.json"
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    d = {}
c = (d.get("counts") or {})
if not c:
    print("  暂无故障 ✅")
else:
    order = ["dropped_text", "loop_fallback", "marker_only_text", "poke_fail", "vision_fail", "proactive_fail"]
    for k in sorted(c, key=lambda x: (order.index(x) if x in order else 99, -int(c[x]))):
        print("  %-18s %d" % (k, c[k]))
    up = d.get("updated") or 0
    print("  更新时间:", time.strftime("%m-%d %H:%M", time.localtime(up)) if up else "-")
    warn = [k for k in ("dropped_text", "loop_fallback") if int(c.get(k, 0)) >= 5]
    if warn:
        print("  ⚠️ 需要关注:", "、".join(warn))
PY
echo "=== 定时 / 表情库 ==="
python3 - <<PY
import json, time
base = "/opt/astrbot/data/plugins/qq_peak_gate/data/"
try:
    items = json.load(open(base + "agent_wake.json", encoding="utf-8")) or []
except Exception:
    items = []
print("  待办定时:", len(items), end="")
dues = [float(x.get("due") or 0) for x in items]
if dues:
    print("  最近一条:", time.strftime("%H:%M:%S", time.localtime(min(dues))), end="")
print()
try:
    idx = json.load(open(base + "stickers/index.json", encoding="utf-8"))
    print("  表情库:", len(idx.get("items") or []), "张")
except Exception:
    print("  表情库: 读不到")
PY
echo "=== 最近 30 分钟错误 ==="
out=$(journalctl -u astrbot --since "-30min" --no-pager 2>/dev/null | grep -icE "error|critical|traceback")
if [ "$out" = "0" ]; then echo "  无"; else journalctl -u astrbot --since "-30min" --no-pager | grep -iE "error|critical|traceback" | tail -5; fi
echo "=== 常用命令 ==="
echo "  systemctl restart astrbot | journalctl -u astrbot -f | tail -f /root/lag-monitor.log"
