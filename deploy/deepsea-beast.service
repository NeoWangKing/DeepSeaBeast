[Unit]
Description=DeepSeaBeast core (QQ bot via OneBot reverse WS)
After=network-online.target snowluma.service
Wants=network-online.target

[Service]
Type=simple
User=astrbot
Group=astrbot
WorkingDirectory=/opt/deepsea
# 不带 --channel：让 core.toml 的 [adapters.*] 决定开哪些通道（onebot + socket）
ExecStart=/opt/deepsea/.venv/bin/python -m core core.toml
Restart=always
RestartSec=3
MemoryMax=768M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
